source 'https://rubygems.org'

gem 'jekyll', '~> 4.3'
gem 'webrick' # needed by `jekyll serve` on Ruby 3+

group :jekyll_plugins do
  gem 'jekyll-archives'        # year / tag / category pages
  gem 'jekyll-feed'            # /feed.xml
  gem 'jekyll-link-attributes' # external links open in a new tab
  gem 'nokogiri'               # required by jekyll-link-attributes
  gem 'jekyll-sitemap'         # /sitemap.xml
end
